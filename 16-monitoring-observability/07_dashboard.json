{
  "displayName": "Digest Worker Health",
  "gridLayout": {
    "columns": "2",
    "widgets": [
      {
        "title": "Request Count (topic 2)",
        "xyChart": {
          "dataSets": [
            {
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "metric.type=\"run.googleapis.com/request_count\" resource.type=\"cloud_run_revision\"",
                  "aggregation": { "alignmentPeriod": "60s", "perSeriesAligner": "ALIGN_RATE" }
                }
              },
              "plotType": "LINE"
            }
          ]
        }
      },
      {
        "title": "Simulated Error Count (topic 3/6)",
        "xyChart": {
          "dataSets": [
            {
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "metric.type=\"logging.googleapis.com/user/digest_simulated_errors\" resource.type=\"cloud_run_revision\"",
                  "aggregation": { "alignmentPeriod": "60s", "perSeriesAligner": "ALIGN_COUNT" }
                }
              },
              "plotType": "LINE"
            }
          ]
        }
      },
      {
        "title": "Request Latency, p95 (topic 2/4)",
        "xyChart": {
          "dataSets": [
            {
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "metric.type=\"run.googleapis.com/request_latencies\" resource.type=\"cloud_run_revision\"",
                  "aggregation": {
                    "alignmentPeriod": "60s",
                    "perSeriesAligner": "ALIGN_DELTA",
                    "crossSeriesReducer": "REDUCE_PERCENTILE_95"
                  }
                }
              },
              "plotType": "LINE"
            }
          ]
        }
      },
      {
        "title": "Headlines Processed - custom metric (topic 5)",
        "xyChart": {
          "dataSets": [
            {
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "metric.type=\"custom.googleapis.com/digest/headlines_processed\" resource.type=\"global\"",
                  "aggregation": { "alignmentPeriod": "60s", "perSeriesAligner": "ALIGN_SUM" }
                }
              },
              "plotType": "LINE"
            }
          ]
        }
      }
    ]
  }
}
