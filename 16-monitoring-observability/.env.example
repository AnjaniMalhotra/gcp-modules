# Copy this file to .env and fill in your real values.
# .env is never committed — only this .example file is.

PROJECT_ID=agentic-ai-capstone-1
REGION=us-central1
LOCATION=us-central1

SERVICE_NAME=digest-worker-observable
WORKER_SA_NAME=digest-observable-sa

SECRET_NAME=telegram-bot-token-observability

# DUMMY VALUES — replace with your real Telegram bot details (reuse an
# existing bot from Module 14/15, or create a fresh one via @BotFather)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_CHAT_ID=your-telegram-chat-id-here

# DUMMY VALUE — replace with a real email you can check, used as the
# alert notification channel in topic 6
NOTIFICATION_EMAIL=your-email@example.com

# Filled in AFTER the initial deploy — paste the printed Cloud Run URL here
SERVICE_URL=https://REPLACE-ME-AFTER-DEPLOY.run.app
