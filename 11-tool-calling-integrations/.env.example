# Copy this file to .env and fill in your real values.
# .env is never committed — only this .example file is.
#
# Every value below is a DUMMY / PLACEHOLDER — replace all of them.
# See docs/03-google-apis.md for exactly how
# to get client_secret.json (Gmail/Calendar), and 06-maps-api.md for the
# Maps API key.

PROJECT_ID=agentic-ai-capstone-1
LOCATION=us-central1

# DUMMY VALUE — replace with a real Maps Platform API key
# (Console -> APIs & Services -> Credentials -> Create Credentials -> API key,
#  then restrict it to Geocoding API + Directions API)
MAPS_API_KEY=your-maps-api-key-here

# NOT stored here on purpose — Gmail/Calendar auth uses two FILES instead of
# an env var, both gitignored:
#   client_secret.json  <- downloaded from the Console (topic 3, step 4)
#   token.json           <- auto-created the first time you run
#                           03_google_apis_oauth_setup.py (topic 3, step 5)

# DUMMY VALUE — a test address you actually control, used by the Gmail demo
# so you never accidentally email a real contact while testing
TEST_EMAIL_ADDRESS=your-test-address@example.com
