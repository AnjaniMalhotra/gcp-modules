# Copy this file to .env and fill in your real values.
# .env is never committed — only this .example file is.
#
# This module has TWO config surfaces, kept in sync:
#   - 00_setup_vars.bat  -> used by the .bat provisioning scripts (topics 4, 6, cleanup)
#   - .env / 00_setup.py -> used by all the Python demo scripts
# Values below should match 00_setup_vars.bat exactly.

PROJECT_ID=agentic-ai-capstone-1
LOCATION=us-central1
REGION=us-central1
ZONE=us-central1-a

REDIS_INSTANCE_NAME=agent-memory-redis
BASTION_VM_NAME=agent-memory-bastion

CLOUD_SQL_INSTANCE_NAME=agent-memory-sql
CLOUD_SQL_DB_NAME=memory_db
CLOUD_SQL_USER=postgres
# Real secret, not just config — never hardcode this in a script.
CLOUD_SQL_PASSWORD=changeme123
