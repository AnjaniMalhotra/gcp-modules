# Copy this file to .env and fill in your real values.
# .env is never committed — only this .example file is.
#
# Config for the notebooks (customer_support_agent/setup.py reads this file) and
# for the gcloud commands in commands.md, which you can load with:
#     set -a && source .env && set +a
# bat-files/00_setup_vars.bat is the Windows-only original of the same values.
# Keep this file's line endings as LF: with Windows (CRLF) endings, `source .env`
# leaves a hidden \r on every value and gcloud rejects the resource names.

PROJECT_ID=gcp-fde-project
LOCATION=us-central1
REGION=us-central1
ZONE=us-central1-a

REDIS_INSTANCE_NAME=agent-memory-redis
BASTION_VM_NAME=agent-memory-bastion

CLOUD_SQL_INSTANCE_NAME=agent-memory-sql
CLOUD_SQL_DB_NAME=memory_db
CLOUD_SQL_USER=postgres
# Real secret, not just config — never hardcode this in a script.
CLOUD_SQL_PASSWORD=changeme123

# Local end of the SSH tunnel to Memorystore (optional, defaults shown). Use another
# port, e.g. 6380, if a local Redis already owns 6379.
# REDIS_HOST=localhost
# REDIS_PORT=6379
